{
    "include": [
		"~/.config/waybar/modules/modules.jsonc",
		"~/.config/waybar/modules/custom-modules.jsonc",
	],

    "layer": "top",
    "margin-top": 13,

    "modules-left": [
        "custom/launcher",
        "clock",
        "hyprland/workspaces"
    ],

    "custom/launcher": {
        "format": " "
    },

    "modules-center": [
        "custom/notification",
        "custom/media"
    ],

    "modules-right": [
        "custom/pacman",
        "custom/weather",
       "pulseaudio",
        "battery",
        "network",
        "power-profiles-daemon"
    ],

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power Profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": "󰌪"
        }
    },

    
    "network":{
        "format": "󰖩",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected"
    }
}
